@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your account</p>
    </div>

    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="auth-validation-summary" role="alert">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form id="account" method="post" class="auth-form">
        <div class="auth-form-group">
            <div class="auth-form-floating">
                <i class="fas fa-envelope auth-form-icon"></i>
                <input asp-for="Input.Email" class="form-control auth-form-control"
                       autocomplete="username" aria-required="true"
                       placeholder="Enter your email" />
                <label asp-for="Input.Email" class="form-label">Email Address</label>
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="auth-form-group">
            <div class="auth-form-floating">
                <i class="fas fa-lock auth-form-icon"></i>
                <input asp-for="Input.Password" class="form-control auth-form-control"
                       autocomplete="current-password" aria-required="true"
                       placeholder="Enter your password" />
                <label asp-for="Input.Password" class="form-label">Password</label>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="auth-checkbox">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe" class="form-label">
                Remember me on this device
            </label>
        </div>

        <button id="login-submit" type="submit" class="auth-btn auth-btn-primary mb-0">
            <i class="fas fa-sign-in-alt me-2"></i>
            Sign In
        </button>
    </form>

    <div class="auth-links">
        <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link">
            <i class="fas fa-question-circle me-1"></i>
            Forgot your password?
        </a>
    </div>

    <div class="auth-divider"></div>

    <div class="auth-links mt-2">
        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-link">
            <i class="fas fa-envelope me-1"></i>
            Resend email confirmation
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}