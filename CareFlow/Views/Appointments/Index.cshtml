@model PagedResult<AppointmentViewModel>

@{
    ViewData["Title"] = "List of appointments";
}

<a class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createModal">
    <i class="fa fa-plus"></i> New appointment
</a>

<!-- Create Appointment Modal -->
<partial name="_CreatePartial" model="new CreateAppointmentViewModel()" />

<!-- Cancel Appointment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-controller="Appointments" asp-action="Cancel">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelModalLabel">Cancel appointment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="cancelId" name="Id" />
                    Are you sure you want to cancel <span id="cancelPatientName" class="fw-bold"></span> appointment with
                    <span id="cancelDoctorName" class="fw-bold"></span> on <span id="cancelDate" class="fw-bold"></span> at
                    <span id="cancelStartTime" class="fw-bold"></span> ?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr class="text-center text-muted">
                <td colspan="6">No items found</td>
            </tr>
        }
        else
        {
            @foreach (var appointment in Model.Items)
            {
                <tr class="align-middle">
                    <td>@appointment.Date.ToShortDateString()</td>
                    <td>@appointment.StartTime.ToString("hh\\:mm") - @appointment.EndTime.ToString("hh\\:mm")</td>
                    <td>@appointment.PatientName</td>
                    <td>@appointment.DoctorName</td>
                    <td>
                        @if (appointment.Status == AppointmentStatus.Scheduled)
                        {
                            <span class="badge bg-warning">
                                <i class="far fa-calendar"></i> @appointment.Status.ToString()
                            </span>
                        }
                        else if (appointment.Status == AppointmentStatus.Completed)
                        {
                            <span class="badge bg-success">
                                <i class="far fa-calendar-check"></i> @appointment.Status.ToString()
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                <i class="far fa-calendar-xmark"></i> @appointment.Status.ToString()
                            </span>
                        }
                    </td>
                    <td>
                        @if (appointment.Status == AppointmentStatus.Scheduled)
                        { 
                            <a class="btn btn-danger" 
                               role="button"
                               data-bs-toggle="modal"
                               data-bs-target="#cancelModal"
                               data-id="@appointment.Id"
                               data-patientName="@appointment.PatientName"
                               data-doctorName="@appointment.DoctorName"
                               data-date="@appointment.Date.ToString("D")"
                               data-startTime="@appointment.StartTime.ToString("hh\\:mm")"
                               title="Cancel appointment">
                                <i class="fas fa-calendar-xmark"></i>
                            </a>
                            <a class="btn btn-success" 
                               asp-controller="Consultations" 
                               asp-action="Create" 
                               asp-route-appointmentId="@appointment.Id"
                               title="New consultation">
                                <i class="fas fa-file-medical"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const createModal = document.getElementById('createModal');
        $('.patients-select').select2({
            theme: 'bootstrap-5',
            placeholder: "-- Select a patient --",
            allowClear: true,
            dropdownParent: $(createModal),
            ajax: {
                url: '@Url.Action("Search", "Patients")',
                delay: 250,
                data: params => ({ query: params.term }),
                processResults: data => ({ results: data })
            },
            cache: true,
            minimumInputLength: 2
        });

        $('.doctors-select').select2({
            theme: 'bootstrap-5',
            placeholder: "-- Select a doctor --",
            allowClear: true,
            dropdownParent: $(createModal),
            ajax: {
                url: '@Url.Action("Search", "Doctors")',
                delay: 250,
                data: params => ({ query: params.term }),
                processResults: data => ({ results: data })
            },
            cache: true,
            minimumInputLength: 2
        });
    </script>
    <script>
        const cancelModal = document.getElementById('cancelModal');
        cancelModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const patientName = button.getAttribute('data-patientName');
            const doctorName = button.getAttribute('data-doctorName');
            const date = button.getAttribute('data-date');
            const startTime = button.getAttribute('data-startTime');

            document.getElementById('cancelId').value = id;
            document.getElementById('cancelPatientName').innerText = patientName + '\'s';
            document.getElementById('cancelDoctorName').innerText = doctorName;
            document.getElementById('cancelDate').innerText = date;
            document.getElementById('cancelStartTime').innerText = startTime;
        });
    </script>
}