@model CreateConsultationViewModel
@{
    ViewData["Title"] = "Create";
}

<form asp-action="Create" method="post">
    <input type="text" asp-for="AppointmentId" />
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Date" class="form-label required"></label>
            <input type="date" asp-for="Date" class="form-control" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DoctorId" class="form-label required"></label>
            <select asp-for="DoctorId" class="form-select doctors-select">
                <option></option>
            </select>
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PatientId" class="form-label required"></label>
            <select asp-for="PatientId" class="form-select patients-select">
                <option></option>
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Weight" class="form-label"></label>
            <input type="number" asp-for="Weight" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Height" class="form-label"></label>
            <input type="number" asp-for="Height" class="form-control" />
            <span asp-validation-for="Height" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Temperature" class="form-label"></label>
            <input type="number" asp-for="Temperature" class="form-control" />
            <span asp-validation-for="Temperature" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Symptoms" class="form-label"></label>
            <textarea asp-for="Symptoms" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Symptoms" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Diagnosis" class="form-label required"></label>
            <textarea asp-for="Diagnosis" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Diagnosis" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Treatment" class="form-label required"></label>
            <textarea asp-for="Treatment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Treatment" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-success w-100">
        Save
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('.patients-select').select2({
            theme: 'bootstrap-5',
            placeholder: "-- Select a patient --",
            allowClear: true,
            ajax: {
                url: '@Url.Action("Search", "Patients")',
                delay: 250,
                data: params => ({ query: params.term }),
                processResults: data => ({ results: data })
            },
            cache: true,
            minimumInputLength: 2
        });

        $('.doctors-select').select2({
            theme: 'bootstrap-5',
            placeholder: "-- Select a doctor --",
            allowClear: true,
            ajax: {
                url: '@Url.Action("Search", "Doctors")',
                delay: 250,
                data: params => ({ query: params.term }),
                processResults: data => ({ results: data })
            },
            cache: true,
            minimumInputLength: 2
        });
    </script>
}