@model PagedResult<DoctorViewModel>

@{
    ViewData["Title"] = "List of doctors";
    var specialties = ViewBag.Specialties as List<SelectListItem> ?? new List<SelectListItem>();
}

<a class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createModal">
    <i class="fa fa-plus"></i> New doctor
</a>

<!-- Create Doctor Modal -->
<partial name="_CreatePartial" model="new AddDoctorViewModel { Specialties = specialties }" />

<!-- Update Doctor Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-controller="Doctors" asp-action="Edit">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel">Update doctor's infos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="updateId" name="Id" />
                    <div class="mb-3">
                        <label for="updateFirstName" class="form-label required">First name</label>
                        <input type="text" class="form-control" id="updateFirstName" name="FirstName" required />
                    </div>
                    <div class="mb-3">
                        <label for="updateLastName" class="form-label required">Last name</label>
                        <input type="text" class="form-control" id="updateLastName" name="LastName" required />
                    </div>
                    <div class="mb-3">
                        <label for="updateSpecId" class="form-label required">Specialty</label>
                        <select class="form-select specialties-select" id="updateSpecId" name="SpecialtyId" asp-items="specialties">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Contact</th>
            <th>Specialty</th>
            <th class="text-end">Patients</th>
            <th class="text-end">Upcoming appointments</th>
            <th class="text-center">Has user account</th>
            <th class="text-center">Is active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr class="text-center text-muted">
                <td colspan="8">No items found</td>
            </tr>
        }
        else
        {
            @foreach (var doctor in Model.Items)
            {
                <tr class="align-middle">
                    <td>@doctor.FullName</td>
                    <td>
                        @doctor.Email
                        @if (!string.IsNullOrEmpty(doctor.PhoneNumber))
                        {
                            <p class="small text-muted mb-0">@doctor.PhoneNumber</p>
                        }
                    </td>
                    <td>@doctor.SpecialtyName</td>
                    <td class="text-end">@doctor.PatientsCount</td>
                    <td class="text-end">@doctor.UpcomingAppointments</td>
                    <td class="text-center">
                        @if (doctor.HasUserAccount)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-xmark text-danger"></i>
                        }
                    </td>
                    <td class="text-center">
                        @if (doctor.IsActive)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-xmark text-danger"></i>
                        }
                    </td>
                    <td class="autofill">
                        <a class="btn btn-primary" asp-action="Details" asp-route-id="@doctor.Id" title="View details">
                            <i class="fas fa-address-card"></i>
                        </a>
                        <a class="btn btn-info"
                           role="button"
                           data-bs-toggle="modal"
                           data-bs-target="#updateModal"
                           data-id="@doctor.Id"
                           data-fname="@doctor.FirstName"
                           data-lname="@doctor.LastName"
                           data-specid="@doctor.SpecialtyId"
                           title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('.specialties-select').each(function () {
            const $this = $(this);
            const $modal = $this.closest('.modal');
        
            $this.select2({
                theme: 'bootstrap-5',
                placeholder: "-- Select a specialty --",
                allowClear: true,
                dropdownParent: $modal.length ? $modal : $(document.body),
                ajax: {
                    url: '@Url.Action("Search", "Specialties")',
                    delay: 250,
                    data: params => ({ query: params.term }),
                    processResults: data => ({ results: data })
                },
                minimumInputLength: 2
            });
        });
    </script>
    <script>
        const updateModal = document.getElementById('updateModal');
        updateModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const fname = button.getAttribute('data-fname');
            const lname = button.getAttribute('data-lname');
            const specid = button.getAttribute('data-specid');

            document.getElementById('updateId').value = id;
            document.getElementById('updateFirstName').value = fname;
            document.getElementById('updateLastName').value = lname;
            $('#updateSpecId').val(specid).trigger('change');
        });
    </script>
}