@model PagedResult<PatientViewModel>
@{
    ViewData["Title"] = "List of patients";
}

<a class="btn btn-primary mb-3" asp-action="Create">
    <i class="fa fa-plus"></i> New patient
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Contact</th>
            <th>Gender</th>
            <th>Age</th>
            <th>Address</th>
            <th>Registration date</th>
            <th class="text-center">Has user account</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr class="text-center text-muted">
                <td colspan="9">No items found</td>
            </tr>
        }
        else
        {
            @foreach (var patient in Model.Items)
            {
                <tr class="align-middle">
                    <td>@patient.FirstName</td>
                    <td>@patient.LastName</td>
                    <td>
                        @patient.Email
                        @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                        {
                            <p class="small text-muted mb-0">@patient.PhoneNumber</p>
                        }
                    </td>
                    <td>
                        @{ string badgeColor = patient.Gender == Gender.Male ? "primary" : patient.Gender == Gender.Female ? "danger" : "secondary"; }
                        <span class="badge bg-@badgeColor">
                            @patient.Gender.ToString()
                        </span>
                    </td>
                    <td>@patient.Age years</td>
                    <td>@patient.Address?.City, @patient.Address?.Province</td>
                    <td>@patient.RegistrationDate.ToShortDateString()</td>
                    <td class="text-center">
                        @if (patient.HasUserAccount)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-xmark text-danger"></i>
                        }
                    </td>
                    <td class="autofill">
                        <a class="btn btn-warning" asp-action="Details" asp-route-id="@patient.Id" title="Details">
                            <i class="fa fa-clipboard-list"></i>
                        </a>
                        <a class="btn btn-info" asp-action="Edit" asp-route-id="@patient.Id" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>