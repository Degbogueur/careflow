@model PagedResult<SpecialtyViewModel>
@{
    ViewData["Title"] = "Index";
    string[] colors = { "primary", "warning", "danger", "success", "info", "secondary" };
    Random random = new Random();
}

<style>
    .icon-container {
        width: 40px;
        height: 40px;
        border-radius: 0.5rem;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-action {
        padding: 0.375rem 0.75rem;
        border: none;
        background: transparent;
        border-radius: 0.375rem;
        transition: all 0.15s ease-in-out;
    }

        .btn-action:hover {
            background-color: #f8f9fa;
        }

    .btn-delete:hover {
        background-color: #f8f9fa;
        color: #dc3545 !important;
    }

    .text-muted-custom {
        color: #6c757d !important;
    }
</style>

<a class="btn btn-primary mb-3" href="#" data-bs-toggle="modal" data-bs-target="#createModal">
    <i class="fa fa-plus"></i> New specialty
</a>

<!-- Create Specialty Modal -->
<partial name="_CreatePartial" model="new AddSpecialtyViewModel { Name = string.Empty }" />

<!-- Update Specialty Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Specialties" asp-action="Edit" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel">Update existing specialty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="updateId" name="Id" />
                    <div class="mb-3">
                        <label for="updateName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="updateName" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label for="updateDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="updateDescription" name="Description" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-secondary text-center">
        <i class="fa fa-triangle-exclamation"></i> No items found
    </div>
}
else
{
    <div class="row g-4 align-items-lg-stretch">
        @foreach (var specialty in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card specialty-card shadow-sm h-100 d-flex flex-column">
                    <div class="card-header bg-white border-0 pb-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-container">
                                    <i class="fa fa-stethoscope text-@colors[random.Next(colors.Length)]" style="font-size: 1.25rem;"></i>
                                </div>
                                <h5 class="card-title mb-0 fs-5">@specialty.Name</h5>
                            </div>

                            <div class="d-flex gap-1">
                                <button class="btn btn-action" 
                                        type="button" 
                                        data-bs-toggle="modal"
                                        data-bs-target="#updateModal"
                                        data-id="@specialty.Id"
                                        data-name="@specialty.Name"
                                        data-description="@specialty.Description"
                                        title="Edit">
                                    <i class="fa fa-pen-to-square" style="font-size: 1rem;"></i>
                                </button>
                                <button class="btn btn-action btn-delete text-danger" type="button" title="Delete">
                                    <i class="fa fa-trash-can" style="font-size: 1rem;"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-3 d-flex flex-column">
                        <p class="text-muted-custom small mb-4">
                            @if (!string.IsNullOrWhiteSpace(specialty.Description))
                            {
                                @specialty.Description
                            }
                            else
                            { 
                                <span class="fst-italic">No description</span>
                            }
                        </p>

                        <div class="border-top pt-3 mt-auto">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fas fa-user-md" style="font-size: 1rem;"></i>
                                    <span class="fw-medium">@specialty.DoctorsCount</span>
                                    <span class="small text-muted-custom">doctors</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const updateModal = document.getElementById('updateModal');
        updateModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const description = button.getAttribute('data-description');

            document.getElementById('updateId').value = id;
            document.getElementById('updateName').value = name;
            document.getElementById('updateDescription').value = description || '';
        });
    </script>
}
